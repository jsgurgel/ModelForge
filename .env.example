# Copie para .env (docker compose lê este arquivo automaticamente).
# Token de acesso da API. Vazio = sem autenticação (apenas para uso local). Gere um valor longo, por exemplo:
#   openssl rand -hex 32
API_TOKEN=
# Hosts de banco permitidos (separados por vírgula; aceita *.dominio.com). Vazio = qualquer host.
BANCO_HOSTS_PERMITIDOS=
# Chave para cifrar senhas das conexões salvas (senão o servidor gera uma chave em arquivo).
CONEXOES_KEY=
# Origem do front-end aceita pelo CORS quando o front roda fora do compose.
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PORT=3100
FRONTEND_PORT=5173
