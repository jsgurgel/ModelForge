END;\n\n$corpo1$ LANGUAGE plpgsql;\n\nCREATE OR REPLACE PROCEDURE \"limpar\"(p_dias integer) AS $$\n BEGIN END; \n$$ LANGUAGE plpgsql;\n\nCREATE VIEW \"hidro\".\"vw_est\" AS\nSELECT id, uf FROM hidro.estacao\n;\n\nCREATE MATERIALIZED VIEW \"vw_resumo\" AS\nSELECT count(*) AS total FROM hidro.estacao\n;","orm":{"jpa":"// Código JPA gerado a partir de \"ddl_objetos_customizados\" - revise antes de usar em produção.\n\n// ===== Estacao.java =====\nimport javax.persistence.*;\n\n@Entity\n@Table(name = \"estacao\")\npublic class Estacao {\n\n    @Id\n    @Column(name = \"id\")\n    private Integer id;\n\n    @Column(name = \"uf\")\n    private String uf;\n\n    @Column(name = \"sit\")\n    private String sit;\n\n    // getters/setters omitidos\n}\n\n","sqlalchemy":"# Código SQLAlchemy gerado a partir de \"ddl_objetos_customizados\" - revise antes de usar em produção.\nfrom sqlalchemy import Column, Integer, String\nfrom sqlalchemy.ext.declarative import declarative_base\n\nBase = declarative_base()\n\n\nclass Estacao(Base):\n    __tablename__ = \"estacao\"\n\n    id = Column(Integer, primary_key=True)\n    uf = Column(String)\n    sit = Column(String)\n\n\n","prisma":"// Schema Prisma gerado a partir de \"ddl_objetos_customizados\" - revise antes de usar em produção.\n\nmodel Estacao {\n  id Int @id\n  uf String?\n  sit String?\n}\n\n"},"doc":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>ddl_objetos_customizados - Dicionário do modelo</title>\n<style>\n:root {\n  --fundo: #f6f7f9; --papel: #fff; --tinta: #16202b; --suave: #5b6672;\n  --linha: #dde3ea; --acento: #1f5c8b; --acento-fraco: #e6eef5;\n  --pk: #8a6100; --pk-bg: #fbf0d8; --fk: #1f5c8b; --fk-bg: #e2edf6;\n  --un: #2e7d5b; --un-bg: #e2f0e9; --alerta: #a8433b; --alerta-bg: #f8e7e5;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --fundo: #10161d; --papel: #171f28; --tinta: #e3e9ef; --suave: #9aa7b