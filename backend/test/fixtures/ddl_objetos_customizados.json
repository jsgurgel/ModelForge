>hidro.dom_uf</td><td></td><td>sim</td><td class=\"mono\"></td><td></td></tr>\n<tr><td class=\"nome\">sit</td><td class=\"mono\">hidro.situacao</td><td></td><td>sim</td><td class=\"mono\"></td><td></td></tr>\n</tbody>\n</table>\n</div>\n</section>\n<section class=\"objeto\" id=\"vw-vw-est\">\n<h2>vw_est <span class=\"tag\">view</span> <span class=\"tag\">hidro</span></h2>\n<div class=\"rolagem\"><pre class=\"sql\">SELECT id, uf FROM hidro.estacao</pre></div>\n</section>\n<section class=\"objeto\" id=\"vw-vw-resumo\">\n<h2>vw_resumo <span class=\"tag\">view materializada</span></h2>\n<div class=\"rolagem\"><pre class=\"sql\">SELECT count(*) AS total FROM hidro.estacao</pre></div>\n</section>\n<section class=\"objeto\" id=\"tp-dom-uf\">\n<h2>dom_uf <span class=\"tag\">domain</span> <span class=\"tag\">hidro</span></h2>\n<ul class=\"lista\">\n<li>tipo base: <span class=\"mono\">CHAR(2)</span></li>\n<li>default: <span class=\"mono\">'CE'</span></li>\n<li>não nulo</li>\n<li>restrição: <span class=\"mono\">VALUE IN ('CE','PI')</span></li>\n</ul>\n</section>\n<section class=\"objeto\" id=\"tp-dom-simples\">\n<h2>dom_simples <span class=\"tag\">domain</span></h2>\n<ul class=\"lista\">\n<li>tipo base: <span class=\"mono\">INTEGER</span></li>\n</ul>\n</section>\n<section class=\"objeto\" id=\"tp-situacao\">\n<h2>situacao <span class=\"tag\">enum</span> <span class=\"tag\">hidro</span></h2>\n<ul class=\"lista\">\n<li><span class=\"mono\">ativa</span></li>\n<li><span class=\"mono\">inativa</span></li>\n<li><span class=\"mono\">it's</span></li>\n</ul>\n</section>\n<section class=\"objeto\" id=\"tp-cor\">\n<h2>cor <span class=\"tag\">enum</span></h2>\n<ul class=\"lista\">\n<li><span class=\"mono\">vermelho</span></li>\n<li><span class=\"mono\">verde</span></li>\n</ul>\n</section>\n<section class=\"objeto\" id=\"sq-seq-est\">\n<h2>seq_est <span class=\"tag\">sequence</span> <span class=\"tag\">hidro</span></h2>\n<ul class=\"lista\">\n<li>início: <span class=\"mono\">100</span></li>\n<li>incremento: <span class=\"mono\">5</span></li>\n<li>valor mínimo: <span class=\"mono\">1</span></li>\n<li>valor máximo: <span class=\"mono\">9999</span></li>\n<li>cíclica</li>\n</ul>\n</section>\n<section class=\"objeto\" id=\"sq-seq-simples\">\n<h2>seq_simples <span class=\"tag\">sequence</span></h2>\n<ul class=\"lista\">\n</ul>\n</section>\n<section class=\"objeto\" id=\"rt-media\">\n<h2>media(p_ini date, p_fim date) <span class=\"tag\">function</span> <span class=\"tag\">hidro</span></h2>\n<ul class=\"lista\">\n<li>retorna: <span class=\"mono\">numeric(10,2)</span></li>\n<li>linguagem: <span class=\"mono\">plpgsql</span></li>\n</ul>\n<div class=\"rolagem\"><pre class=\"sql\">\nBEGIN\n  RETURN 1;\nEND;\n</pre></div>\n</section>\n<section class=\"objeto\" id=\"rt-g\">\n<h2>g() <span class=\"tag\">function</span></h2>\n<ul class=\"lista\">\n<li>retorna: <span class=\"mono\">text</span></li>\n<li>linguagem: <span class=\"mono\">plpgsql</span></li>\n</ul>\n<div class=\"rolagem\"><pre class=\"sql\">\nBEGIN\n  EXECUTE $$ select 1 $$;\n  RETURN 'x';\nEND;\n</pre></div>\n</section>\n<section class=\"objeto\" id=\"rt-limpar\">\n<h2>limpar(p_dias integer) <span class=\"tag\">procedure</span></h2>\n<ul class=\"lista\">\n<li>linguagem: <span class=\"mono\">plpgsql</span></li>\n</ul>\n<div class=\"rolagem\"><pre class=\"sql\"> BEGIN END; </pre></div>\n</section>\n<footer><p>ModelForge</p></footer>\n</body>\n</html>\n","validacao":"Nenhum problema encontrado em \"ddl_objetos_customizados\" (lógico).","dsl":"// DSL gerada a partir de \"ddl_objetos_customizados\" - reimportável via Modelagem via DSL de Texto.\n\ntabela estacao {\n    id INTEGER pk\n    uf hidro.dom_uf\n    sit hidro.situacao\n}\n\n"}