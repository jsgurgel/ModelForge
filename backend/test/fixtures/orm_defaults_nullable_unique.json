 =====\nimport javax.persistence.*;\nimport java.time.LocalDateTime;\nimport java.math.BigDecimal;\n\n@Entity\n@Table(name = \"produto\")\npublic class Produto {\n\n    @Id\n    @Column(name = \"id\")\n    private Integer id;\n\n    @Column(name = \"sku\", nullable = false, length = 20)\n    private String sku;\n\n    @Column(name = \"nome\", nullable = false, length = 100)\n    private String nome;\n\n    @Column(name = \"descricao\")\n    private String descricao;\n\n    @Column(name = \"ativo\", nullable = false)\n    private Boolean ativo;\n\n    @Column(name = \"criado_em\", nullable = false)\n    private LocalDateTime criadoEm;\n\n    @Column(name = \"preco\")\n    private BigDecimal preco;\n\n    @Column(name = \"a\")\n    private Integer a;\n\n    @Column(name = \"b\")\n    private Integer b;\n\n    // getters/setters omitidos\n}\n\n// ===== SemPk.java =====\nimport javax.persistence.*;\n\n@Entity\n@Table(name = \"sem_pk\")\npublic class SemPk {\n\n    @Column(name = \"x\")\n    private Integer x;\n\n    @Column(name = \"y\")\n    private String y;\n\n    // getters/setters omitidos\n}\n\n","sqlalchemy":"# Código SQLAlchemy gerado a partir de \"orm_defaults_nullable_unique\" - revise antes de usar em produção.\nfrom sqlalchemy import Column, Integer, String, Text, Boolean, DateTime, Numeric\nfrom sqlalchemy.ext.declarative import declarative_base\n\nBase = declarative_base()\n\n\nclass Produto(Base):\n    __tablename__ = \"produto\"\n\n    id = Column(Integer, primary_key=True)\n    sku = Column(String(20), nullable=False)\n    nome = Column(String(100), nullable=False)\n    descricao = Column(Text)\n    ativo = Column(Boolean, nullable=False)\n    criado_em = Column(DateTime, nullable=False)\n    preco = Column(Numeric(10, 2))\n    a = Column(Integer)\n    b = Column(Integer)\n\n\nclass SemPk(Base):\n    __tablename__ = \"sem_pk\"\n\n    x = Column(Integer)\n    y = Column(Text)\n\n\n","prisma":"// Schema Prisma gerado a partir de \"orm_defaults_nullable_unique\" - revise antes de usar em produção.\n\nmodel Produto {\n  id Int @id\n  sku String\n  nome String\n  descricao String?\n  ativo Boolean\n  criadoEm DateTime @map(\"criado_em\")\n  preco Decimal?\n  a Int?\n  b Int?\n  @@unique([sku, a, b])\n  @@unique([a, b])\n}\n\nmodel SemPk {\n  x Int?\n  y String?\n  @@map(\"sem_pk\")\n}\n\n"},"doc":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>orm_defaults_nullable_unique - Dicionário do modelo</title>\n<style>\n:root {\n  --fundo: #f6f7f9; --papel: #fff; --tinta: #16202b; --suave: #5b6672;\n  --linha: #dde3ea; --acento: #1f5c8b; --acento-fraco: #e6eef5;\n  --pk: #8a6100; --pk-bg: #fbf0d8; --fk: #1f5c8b; --fk-bg: #e2edf6;\n  --un: #2e7d5b; --un-bg: #e2f0e9; --alerta: #a8433b; --alerta-bg: #f8e7e5;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --fundo: #10161d; --papel: #171f28; --tinta: #e3e9ef; --suave: #9aa7b3;\n    --linha: #26313d; --acento: #74b4df; --acento-fraco: #17293a;\n    --pk: #d9ab5b; --pk-bg: #2b2214; --fk: #74b4df; --fk-bg: #14283a;\n    --un: #5fb88e; --un-bg: #142a20; --alerta: #de7a70; --alerta-bg: #2e1a18;\n  }\n}\n* { box-sizing: border-box; }\nbody { margin: 0; padding: 2rem 1.25rem 4rem; background: var(--fundo); color: var(--tinta);\n       font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; line-height: 1.6; }\nheader, nav, section, footer { max-width: 60rem; margin-inline: auto; }\nheader { border-top: 3px solid var(--acento); padding-top: 1.25rem; margin-bottom: 2rem; }\n.eyebrow { margin: 0; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--acento); }\nh1 { margin: .3rem 0; font-size: clamp(1.6rem, 4vw, 2.3rem); letter-spacing: -.02em; }\n.meta { margin: 0; color: var(--suave); font-size: .9rem; }\n.resumo { display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));\n          gap: 1px; background: var(--l